msgstr "Copier les chemins sélectionnés comme URI file://"

#: lib.rs:77
msgid "Embedded Terminal"
msgstr "Terminal intégré"

#: lib.rs:78
msgid "Show or hide the terminal at the bottom of the window"
msgstr "Afficher / masquer le terminal en bas de la fenêtre"

#: pane.rs:387
msgid "Select exactly one folder"
msgstr "Sélectionnez exactement un dossier"

#: pane.rs:492
msgid "Select All"
msgstr "Tout sélectionner"

#: pane.rs:497
msgid "Insert the {var} Variable"
msgstr "Insérer la variable {var}"

#: pane.rs:501 prefs.rs:175
msgid "Follow Nautilus Folder"
msgstr "Suivre le dossier de Nautilus"

#: pane.rs:509 panel.rs:733
msgid "Preferences…"
msgstr "Paramètres…"

#: pane.rs:589
msgid "Nothing inserted: no local file in the drop"
msgstr "Rien n'a été inséré : aucun fichier local"

#: pane.rs:596 panel.rs:262
msgid "{n} missing item skipped"
msgid_plural "{n} missing items skipped"
msgstr[0] "{n} élément manquant ignoré"
msgstr[1] "{n} éléments manquants ignorés"

#: pane.rs:599 panel.rs:253
msgid "Cannot insert: a file name cannot be written safely for this shell"
msgstr ""
"Insertion impossible : un nom de fichier ne peut pas être écrit sans risque "
"pour ce shell"

#: panel.rs:234
msgid "Folder no longer exists"
msgstr "Le dossier n'existe plus"

